# Optional lead delivery settings for serverless deployments.
# Without these, /api/leads logs locally and returns "not configured" in production
# so the browser can fall back to the existing FormSubmit delivery path.

# Send leads to a private webhook endpoint.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Or forward leads server-side to FormSubmit.
FORMSUBMIT_EMAIL=patsellsflhomes@gmail.com

# Or forward to any endpoint that accepts a JSON POST.
LEAD_FORWARD_URL=

# Accept log-only leads in production-like previews. Do not enable for production.
LEAD_DEV_ACCEPT=false
